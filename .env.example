# PostgreSQL connection string (required)
# Example: postgresql://user:password@host:port/database?schema=public
DATABASE_URL=

# Session cookie secret — generate a random 32+ character string (required)
SESSION_SECRET=

# AI provider API keys (optional — if not set, the app falls back to mock providers)
GEMINI_API_KEY=
RUNWAY_API_KEY=
SARVAM_API_KEY=

# Optional Anthropic fallback for script generation
ANTHROPIC_API_KEY=
